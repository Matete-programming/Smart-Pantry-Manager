<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes You Can Make"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#234B3C"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/txtRecipeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking your pantry..."
        android:textSize="15sp"
        android:textColor="#555555"
        android:paddingBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry" />

</LinearLayout>
