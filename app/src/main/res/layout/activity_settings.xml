<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#234B3C"
        android:paddingBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry Notifications"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#234B3C" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable or disable reminders for ingredients approaching their expiry date."
        android:textSize="15sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp" />

    <Switch
        android:id="@+id/switchExpiryAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable expiry alerts"
        android:layout_marginTop="20dp"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Settings"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnBackFromSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry"
        android:layout_marginTop="8dp" />

</LinearLayout>
